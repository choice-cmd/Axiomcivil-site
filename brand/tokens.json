{
  "$comment": "Single source of truth for Axiom Civil brand colors and type. Used by the site (src/styles/tokens.css mirrors these), email signature, letterhead, and any agent-generated collateral.",
  "color": {
    "ink":        { "value": "#070A10", "use": "Page background (dark)" },
    "ink-2":      { "value": "#0C1220", "use": "Raised surfaces" },
    "ink-3":      { "value": "#111A2B", "use": "Cards, hover" },
    "navy":       { "value": "#0A1E33", "use": "Logo navy — on light backgrounds" },
    "navy-lift":  { "value": "#1C4A7A", "use": "Logo navy — on dark backgrounds" },
    "cyan":       { "value": "#33E3F0", "use": "Logo pixels, accents, primary buttons" },
    "steel":      { "value": "#C3C8CD", "use": "Logo steel stroke, secondary accents" },
    "paper":      { "value": "#FFFFFF", "use": "Print / light backgrounds" },
    "text-dark":  { "value": "#0B0F17", "use": "Body text on light backgrounds" }
  },
  "type": {
    "display": { "family": "Montserrat", "weights": [600, 700], "use": "Wordmark, headings, names on cards" },
