    "horizontal-light": "public/brand/axiom-horizontal.svg",
    "horizontal-dark": "public/brand/axiom-horizontal-dark.svg",
    "rules": [
      "Use the -dark variants on dark backgrounds; the navy is lifted so it stays visible.",
      "Minimum clear space around the logo: the height of the steel stroke's width.",
