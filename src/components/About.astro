---
import about from '../data/about.json';
import site from '../data/site.json';
---
<section class="band alt" id="about">
  <div class="wrap">
    <p class="eyebrow">About</p>
    <h2 class="reveal">{about.heading}</h2>
    <div class="grid">
      <div class="reveal">
        <div class="who">
          <div class="name">{site.principal.name}, {site.principal.credentials}</div>
          <div class="title">{site.principal.title}</div>
        </div>
        {about.paragraphs.map((p) => <p class="body">{p}</p>)}
        <blockquote>{about.highlight}</blockquote>
        <p class="label">Software</p>
        <div class="tags">{about.software.map((s) => <span class="tag">{s}</span>)}</div>
      </div>
      <ul class="creds reveal">
        {about.credentials.map((c) => (
          <li>
            <span class="dot" aria-hidden="true"></span>
            <div>
              <strong>{c.title}</strong>
              {c.detail && <span>{c.detail}</span>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 80px); margin-top: 2.5rem; align-items: start; }
  .who { margin-bottom: 1.4rem; }
  .name { font-family: var(--f-display); font-weight: 600; font-size: 15px; letter-spacing: 0.14em; text-transform: uppercase; }
  .title { font-size: 13px; color: var(--cyan); margin-top: 2px; }
  blockquote { border-left: 1px solid var(--cyan-line); padding-left: 1.25rem; margin: 2rem 0; font-size: 15.5px; font-style: italic; font-weight: 300; color: var(--text-2); line-height: 1.75; }
  .label { font-family: var(--f-display); font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-4); margin: 2rem 0 0.8rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .creds { list-style: none; }
  .creds li { display: flex; gap: 1rem; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .creds li:first-child { border-top: 1px solid var(--line); }
  .dot { width: 6px; height: 6px; border-radius: 1px; background: var(--cyan); flex-shrink: 0; margin-top: 8px; }
  .creds strong { display: block; font-weight: 400; color: var(--text-2); font-size: 14.5px; margin-bottom: 2px; }
  .creds span { font-size: 13px; color: var(--text-3); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
