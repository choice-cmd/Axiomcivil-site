---
import { getCollection } from 'astro:content';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<section class="band" id="services">
  <div class="wrap">
    <p class="eyebrow">Services</p>
    <h2 class="reveal">Senior survey leadership across every phase of the job.</h2>
    <div class="grid">
      {services.map((s, i) => (
        <article class="card reveal">
          <div class="num">0{i + 1}</div>
          <h3>{s.data.title}</h3>
          <p class="body">{s.data.summary}</p>
          <ul>{s.data.bullets.map((b) => <li>{b}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 3rem; border: 1px solid var(--line); }
  .card { position: relative; padding: 32px 28px; border-left: 1px solid var(--line); transition: background 0.3s; }
  .card:first-child { border-left: 0; }
  .card:hover { background: var(--ink-2); }
  .card::before { content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 1px; background: var(--cyan); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease; }
  .card:hover::before { transform: scaleX(1); }
  .num { font-family: var(--f-mono); font-size: 12px; color: var(--cyan); margin-bottom: 1.2rem; }
  h3 { margin-bottom: 0.8rem; }
  .body { font-size: 14px; }
  ul { list-style: none; margin-top: 1.2rem; display: grid; gap: 7px; }
  li { position: relative; padding-left: 16px; font-size: 13px; color: var(--text-3); line-height: 1.5; }
  li::before { content: ''; position: absolute; left: 0; top: 8px; width: 7px; height: 1px; background: var(--cyan); }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .card { border-left: 0; border-top: 1px solid var(--line); }
    .card:first-child { border-top: 0; }
  }
</style>
