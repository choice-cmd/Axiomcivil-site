---
import { getCollection, render } from 'astro:content';
import site from '../data/site.json';
const projects = (await getCollection('projects', ({ data }) => !data.hidden)).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
const owners = [...new Set(projects.flatMap((p) => p.data.owner.split(' · ')))];
---
<section class="band" id="experience">
  <div class="wrap">
    <p class="eyebrow">Project experience</p>
    <h2 class="reveal">A record built on some of America's most demanding projects.</h2>
    <p class="owners reveal"><span>Experience includes work for</span> {owners.join(' · ')}</p>
    <div class="grid">
      {rendered.map(({ p, Content }) => (
        <article class="card reveal">
          <div class="who">{p.data.owner}{p.data.contractor ? ` / ${p.data.contractor}` : ''}</div>
          <h3>{p.data.title}</h3>
          <div class="val">{p.data.value} · {p.data.role}</div>
          <div class="scope"><Content /></div>
          <div class="tags"><span class="tag">{[...p.data.sectors, p.data.location].join(' · ')}</span></div>
        </article>
      ))}
    </div>
    <p class="note">{site.experienceNotice}</p>
  </div>
</section>

<style>
  .owners { font-size: 13px; color: var(--text-2); letter-spacing: 0.04em; margin-top: 0.5rem; }
  .owners span { font-family: var(--f-display); font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-4); margin-right: 0.75rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 2.5rem; }
  .card { position: relative; background: var(--ink); padding: 28px 26px; display: flex; flex-direction: column; transition: background 0.3s; }
  .card:hover { background: var(--ink-2); }
  .who { font-family: var(--f-mono); font-size: 10.5px; color: var(--cyan); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.7rem; }
  h3 { margin-bottom: 0.45rem; }
  .val { font-family: var(--f-mono); font-size: 12px; color: var(--text-3); margin-bottom: 0.8rem; }
  .scope :global(p) { font-size: 13.5px; color: var(--text-3); line-height: 1.7; font-weight: 300; }
  .tags { margin-top: auto; padding-top: 1.2rem; }
  .note { margin-top: 1.5rem; font-size: 12px; color: var(--text-4); max-width: 820px; line-height: 1.6; }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
