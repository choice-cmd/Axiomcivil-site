---
import Base from '../layouts/Base.astro';
---
<Base title="Message received" noindex>
  <section class="band" style="min-height:70vh;display:flex;align-items:center;border-top:0;padding-top:140px">
    <div class="wrap">
      <p class="eyebrow">Thank you</p>
      <h2>Message received.</h2>
      <p class="lede">I'll reply within two business days. If it's urgent, call or text 727-420-1894.</p>
      <p style="margin-top:2rem"><a class="btn btn-ghost" href="/">← Back to home</a></p>
    </div>
  </section>
</Base>
