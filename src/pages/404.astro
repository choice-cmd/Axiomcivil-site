---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="band" style="min-height:70vh;display:flex;align-items:center;border-top:0;padding-top:140px">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h2>That point isn't on the map.</h2>
      <p class="lede">The page you're looking for doesn't exist or has moved.</p>
      <p style="margin-top:2rem"><a class="btn btn-ghost" href="/">← Back to home</a></p>
    </div>
  </section>
</Base>
